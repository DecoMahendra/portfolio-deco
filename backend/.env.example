# Nilai di file ini untuk bekerja di komputer sendiri.
# Untuk server online (Render), lihat catatan "produksi" di tiap bagian —
# nilainya diisi sebagai Environment Variables di dashboard Render, bukan di file.

APP_NAME="Portfolio Deco Mahendra"
APP_ENV=local
APP_KEY=
# Produksi: APP_ENV=production dan APP_DEBUG=false.
# APP_DEBUG=true menampilkan isi kode dan pengaturan saat error — berbahaya kalau online.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produksi: database MySQL online (Aiven). Koneksinya wajib SSL, jadi ada
# dua baris tambahan: MYSQL_ATTR_SSL_CA (letak berkas sertifikat) dan
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Memakai MySQL bawaan XAMPP (port 3306), bukan MariaDB yang jalan di 3307.
# MySQL XAMPP harus dinyalakan dulu lewat XAMPP Control Panel tiap kali bekerja.
DB_PORT=3306
DB_DATABASE=portfolio_deco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary — penyimpanan gambar project & sertifikat.
# Ambil dari Dashboard cloudinary.com > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alamat frontend yang boleh memanggil API, dipisah koma kalau lebih dari satu.
# Produksi: https://decomahendra.vercel.app
FRONTEND_URL=http://localhost:5173
